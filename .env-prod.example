# ==========================================
# Variables de Entorno - Producción
# Ubicación en VPS: /opt/deploy/<proyecto>/.env-prod
# ==========================================

# Base de datos (Reemplazar usuario, contraseña y dbname)
DATABASE_URL="postgresql://postgres:REEMPLAZAR_PASSWORD@db:5432/REEMPLAZAR_DBNAME?schema=public"

# Next Auth (Generar con: npx auth secret o un generador de UUIDs)
AUTH_SECRET="REEMPLAZAR_POR_UN_SECRET_SEGURO_Y_LARGO"

# URL Pública de la Aplicación
NEXT_PUBLIC_APP_URL="https://midominio.com"

# SMTP para Notificaciones (Opcional pero recomendado)
SMTP_HOST="smtp.gmail.com"
SMTP_PORT="587"
SMTP_USER="tu-correo@gmail.com"
SMTP_PASS="tu-password-de-aplicacion"
